# FastAPI uses DATABASE_URL for direct SQLAlchemy/PostgreSQL access to Supabase.
FASTAPI_ENV=local
PROJECT_NAME=CropKart API
SECRET_KEY=replace-with-a-random-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=
DATABASE_URL=
FRONTEND_HOST=http://localhost:3001

# LangFlow connection. Use http://localhost:7860 for local processes;
# Docker Compose overrides the service URL to http://langflow:7860.
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT=60
CROPSATHI_TOOL_KEY=

# CEDA API credentials (server side only).
CEDA_API_KEY=
CEDA_API_BASE_URL=
CEDA_API_TIMEOUT_SECONDS=30

# Optional email configuration.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_SSL=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=

# Optional Supabase API values for future server-side clients.
# The current backend path uses DATABASE_URL; these are not currently required.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
